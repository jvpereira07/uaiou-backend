# Copie para .env (cp .env.example .env) e ajuste se precisar. Valores aqui são de desenvolvimento — nunca usar
# em produção, especialmente os marcados como segredo.
#
# DB_HOST=localhost funciona para rodar o backend localmente (./mvnw spring-boot:run) contra os serviços
# subidos pelo docker-compose (portas publicadas no host). Quando o próprio backend roda DENTRO do
# docker-compose (docker compose up), o serviço "backend" sobrescreve DB_HOST/MINIO_ENDPOINT/REDIS_HOST para os
# nomes internos da rede Docker (postgres/minio/redis) diretamente no docker-compose.yml — não precisa mexer
# aqui para isso funcionar.

# --- Banco de dados (usado desde T-01) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uaiou
DB_USER=uaiou
DB_PASSWORD=uaiou_dev_password
DB_POOL_SIZE=10

# --- Aplicação (T-01) ---
SERVER_PORT=8080

# --- JWT / sessões — segredo de desenvolvimento (usado a partir de T-03) ---
JWT_SECRET=troque-este-valor-de-desenvolvimento-por-um-segredo-forte-em-producao
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Login com Google (usado a partir de T-03) ---
# Client ID OAuth 2.0 do Google Cloud Console (tipo "Web application") — é o "aud" esperado no idToken.
GOOGLE_CLIENT_ID=troque-por-um-client-id-do-google-cloud-console

# --- Recuperação de senha (usado a partir de T-03) ---
PASSWORD_RESET_TTL_MINUTES=30
# Base usada para montar o link enviado por e-mail (ex.: APP_BASE_URL/reset-password?token=...).
APP_BASE_URL=http://localhost:8080

# --- MinIO / storage de arquivos (usado a partir de T-05) ---
MINIO_ENDPOINT=http://localhost:9000
# Host que o CLIENTE (fora do docker-compose) usa para seguir a URL pré-assinada. Rodando localmente é o
# mesmo valor de MINIO_ENDPOINT; dentro do docker-compose, o backend sobrescreve só o MINIO_ENDPOINT para o
# nome do serviço interno — este aqui continua apontando para a porta publicada no host.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=uaiou
MINIO_ROOT_PASSWORD=uaiou_dev_password
MINIO_BUCKET=uaiou-uploads

# --- Redis / cache (usado a partir de T-10 e T-23) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Código de entrega — chave de cifra de desenvolvimento (usado a partir de T-15) ---
DELIVERY_CODE_CIPHER_KEY=troque-esta-chave-de-desenvolvimento-por-32-bytes-aleatorios

# --- Push / notificações (usado a partir de T-08) ---
PUSH_PROVIDER_CREDENTIALS_PATH=./secrets/push-credentials.json

# --- Rotas e navegação (usado a partir de T-25) ---
# Chave do Geoapify (https://myprojects.geoapify.com). VAZIA é estado válido: o recurso de rotas
# desliga e o resto da aplicação sobe normal — GET /orders/{id}/route responde sem trajeto.
ROUTING_API_KEY=

# Chave da geocodificação inversa (coordenada -> CEP nos seletores de endereço no mapa).
# VAZIA herda ROUTING_API_KEY: é a mesma conta Geoapify, e duplicar a variável convidaria a girar
# uma chave e esquecer a outra. Preencha só para separar as cotas dos dois recursos.
GEOCODING_API_KEY=

# --- Administrador inicial (criado no primeiro boot de um banco vazio) ---
# Nenhuma migration insere dados e o autorregistro recusa ADMIN: sem isto, um ambiente novo sobe
# sem nenhuma forma de entrar no painel. O runner só cria se o e-mail ainda não existir — nunca
# sobrescreve senha de conta já existente.
# Os defaults ("admin"/"admin") existem para o ambiente local subir sem configuração. EM PRODUÇÃO
# SÃO CREDENCIAIS PUBLICAMENTE CONHECIDAS: defina valores reais aqui ou troque a senha no primeiro
# acesso.
ADMIN_DEFAULT_EMAIL=admin
ADMIN_DEFAULT_PASS=admin
ADMIN_DEFAULT_LOGIN=admin
# Níveis aceitos pelo banco: atendente, pleno, superadmin.
ADMIN_DEFAULT_NIVEL=pleno

# --- Push (FCM) ---
# Conta de serviço do Firebase (Console > Configurações do projeto > Contas de serviço > Gerar nova
# chave privada). Informe o CAMINHO do JSON ou o CONTEÚDO inteiro do JSON. Ambos vazios: o push só é
# registrado em log e o inbox segue funcionando. SEGREDO — nunca versionar o JSON.
PUSH_PROVIDER_CREDENTIALS_PATH=
PUSH_PROVIDER_CREDENTIALS_JSON=
